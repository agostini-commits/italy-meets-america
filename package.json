{
  "name": "italy-meets-america",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Italy meets America – The Yearbook (Forbes Italia). Static PWA.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "import-data": "tsx scripts/import-data.ts",
    "images": "tsx scripts/build-images.ts",
    "icons": "tsx scripts/make-icons.ts",
    "build": "tsc --noEmit && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "csv-parse": "^6.1.0",
    "sharp": "^0.34.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  }
}
